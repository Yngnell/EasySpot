# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# App
PORT=3000
# Frontend address(es) allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173

# MySQL database (XAMPP default user is root)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=easyspot_db
# true = TypeORM creates/updates tables automatically (development only)
DB_SYNC=true

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Password used for the demo accounts created by `npm run seed`
SEED_PASSWORD=change-me
